# Supabase credentials
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_supabase_service_key

# The site uses purchase-email identity, without account sign-in. Its data
# client uses only the server service key above (legacy service_role JWT or
# sb_secret_ key). SUPABASE_ANON_KEY and PUBLIC_SUPABASE_* are not used.
# Never expose the service key through a PUBLIC_ variable.

# Email (Resend). Required for paid fulfillment and checklist delivery.
# New paid checkout requires a configured key and production sender. Verify
# the sending domain in Resend; the onboarding@resend.dev default cannot be
# used for a public launch. Existing paid orders remain recoverable.
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=STS <hello@yourdomain.com>
# Set your real postal address before commercial/newsletter sends.
# EMAIL_POSTAL_ADDRESS=

# Stripe credentials
# Accepts standard sk_ keys or appropriately permissioned restricted rk_ keys.
# Preflight inspection can remain unverified with a restricted key; use
# dashboard evidence rather than broadening a production key just for checks.
STRIPE_SECRET_KEY=your_stripe_secret_key
# STRIPE_PRICE_ID is a DEV-ONLY fallback. Production requires each edition's
# own price. The standard public offer is USD 5.00, one-time.
STRIPE_PRICE_ID=your_stripe_price_id
STRIPE_PRICE_ID_STANDARD=your_standard_edition_price_id
# Optional legacy Author's Edition. Without an explicit price, that edition
# refuses new checkout. The launch preflight validates the advertised standard
# edition; separately validate any additional edition before offering it.
STRIPE_PRICE_ID_AUTHORS=your_authors_edition_price_id
# Signing secret for /api/webhooks/stripe. New checkout refuses payment when
# this is missing or a placeholder; buyers can close Stripe before returning
# to the receipt page, so webhook fulfillment is required. Per-endpoint AND per-mode:
# the test-mode secret is not the live-mode secret.
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
# Public site origin used in email links. Keep aligned with the deployment.
PUBLIC_BASE_URL=https://survivingthesingularity.com
# Read-only launch preflight target (not a runtime routing control). Override
# both origins for an HTTPS preview, and use --mode=test with test Stripe keys.
PUBLIC_ORIGIN=https://survivingthesingularity.com
# node scripts/check-launch-readiness.mjs checks process configuration only.
# Add --services for authenticated GET-only inspection; no .env is auto-loaded.

# Research bundle delivery (Supabase Storage)
# Create a bucket named "downloads" in your Supabase project (set to private).
# Upload the bundle file to that bucket, then set the path here.
DOWNLOAD_BUCKET=downloads
DOWNLOAD_BUNDLE_PATH=research-bundle-book-v0.11.0.zip
# Copy these from the reviewed src/lib/data/bundleManifest.js AFTER uploading
# and verifying the private storage object. Mismatches disable paid checkout.
DOWNLOAD_BUNDLE_BOOK_VERSION=0.11.0
DOWNLOAD_BUNDLE_SHA256=replace_with_verified_bundle_sha256

# Signing secret for /api/webhooks/resend (Svix). Without it that endpoint
# returns 503 and email_deliveries rows stay at 'sent' forever - nothing ever
# moves them to 'delivered' or 'bounced'. Get it when you add the endpoint in
# Resend -> Webhooks.
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret

# NOTE: BOOK_ACCESS_PASSWORD used to live here. It does not any more - the /book
# codes are plain constants in src/lib/bookAccessCode.js, deliberately, because
# the gate is a soft one (see the comment at the top of that file). Setting this
# variable now does nothing. It is documented as removed rather than deleted
# silently so nobody re-adds it to Cloudflare expecting it to take effect.
# Purchase records are never deleted to enable repeat-purchase tests.
# Use a fresh test email with test-mode services instead.

# Protected reconciliation endpoint and hourly GitHub Actions monitor.
# Set the same random token (at least 32 characters) in hosting and CI secrets.
# ADMIN_RECONCILE_TOKEN=

# Bearer token for /api/admin/activation-codes (mint, list, revoke).
#
# SEPARATE FROM ADMIN_RECONCILE_TOKEN ON PURPOSE. That one authorises READING
# the customer list. This one authorises MINTING CREDENTIALS: anyone who can
# POST with it can manufacture unlimited free access to the paid book. Different
# capability, different secret, so handing the reporting token to a cron job
# does not also hand over the ability to print keys.
#
# Minimum 32 characters - authorizeAdmin() refuses anything shorter and returns
# 503 rather than pretending a weak token is a boundary. Unset means the whole
# endpoint answers 503, which is the correct default: codes can still be minted
# by hand in SQL, and an unminted code has never leaked.
#   openssl rand -base64 48
# ADMIN_ACTIVATION_TOKEN=
