# Supabase credentials
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_supabase_service_key

# The publishable ("anon") key, server-side ONLY. Auth needs it: sign-in talks
# to GoTrue, which authenticates the request with this key. Data access does not
# - that goes through the service role in $lib/server/supabaseAdmin.js.
#
# THE MISSING `PUBLIC_` PREFIX IS THE POINT. SvelteKit inlines any PUBLIC_*
# variable into the browser bundle. Without the prefix it stays in
# $env/dynamic/private and is only readable on the server, which is what keeps
# the key out of the bundle and lets session cookies be httpOnly. See the header
# of src/lib/server/supabaseAuth.js.
#
# Unset is a safe failure: /signup renders and says accounts are unavailable.
SUPABASE_ANON_KEY=your_supabase_anon_key

# PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_ANON_KEY used to be listed here. They
# are gone, and must not come back. src/lib/supabase.js - the browser client
# they existed to feed - was deleted in WO-08, and sql/012 then revoked every
# grant from `anon`, so a browser client returns 42501 on every table anyway.
# Setting them does nothing except ship a key to the browser.
#
# Documented as removed rather than deleted silently, for the same reason
# BOOK_ACCESS_PASSWORD is at the foot of this file: an example file that lists a
# variable is an instruction to set it, and these two were still instructing
# people to recreate exactly what a migration was written to remove.

# Email (Resend) - optional. Without RESEND_API_KEY welcome emails are skipped.
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=STS <hello@yourdomain.com>

# Stripe credentials
STRIPE_SECRET_KEY=your_stripe_secret_key
# STRIPE_PRICE_ID is a DEV-ONLY fallback. In production each edition must have
# its own variable or the sale is refused - an unset edition variable silently
# billing whatever the shared one points at is the 2026-07 $5-charged-$9 defect.
STRIPE_PRICE_ID=your_stripe_price_id
STRIPE_PRICE_ID_STANDARD=your_standard_edition_price_id
# Currently UNSET in production, so /api/stripe-checkout returns 503 for the
# Author's Edition. That is the safe failure, but it does mean the edition
# cannot be bought until this is set in Cloudflare Pages.
STRIPE_PRICE_ID_AUTHORS=your_authors_edition_price_id
# Signing secret for /api/webhooks/stripe. Without it that endpoint returns 503
# and no server-to-server fulfillment happens at all. Per-endpoint AND per-mode:
# the test-mode secret is not the live-mode secret.
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
PUBLIC_BASE_URL=http://localhost:5173

# Research bundle delivery (Supabase Storage)
# Create a bucket named "downloads" in your Supabase project (set to private).
# Upload the bundle file to that bucket, then set the path here.
DOWNLOAD_BUCKET=downloads
DOWNLOAD_BUNDLE_PATH=research-bundle-v1.zip

# Signing secret for /api/webhooks/resend (Svix). Without it that endpoint
# returns 503 and email_deliveries rows stay at 'sent' forever - nothing ever
# moves them to 'delivered' or 'bounced'. Get it when you add the endpoint in
# Resend -> Webhooks.
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret

# NOTE: BOOK_ACCESS_PASSWORD used to live here. It does not any more - the /book
# codes are plain constants in src/lib/bookAccessCode.js, deliberately, because
# the gate is a soft one (see the comment at the top of that file). Setting this
# variable now does nothing. It is documented as removed rather than deleted
# silently so nobody re-adds it to Cloudflare expecting it to take effect.
# OPTIONAL, local/testing only. An email allowed to repeat-purchase the same
# edition; its prior preorder row is deleted before each new insert. Leave
# unset in production so no address can ever trigger that delete path.
# TEST_REPEAT_PURCHASE_EMAIL=you@example.com
