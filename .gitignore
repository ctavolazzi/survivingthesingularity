.DS_Store
node_modules
node_modules/
/build
/.svelte-kit
/package
.env
.env.*
!.env.example
.vercel
.output
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Add these lines to ignore pnpm store
.pnpm-store
**/node_modules/.pnpm/

cloudflare_logs/Discord.dmg

# Supabase files (for security reasons)
/supabase/
# Blanket-ignore .sql so a stray database dump (which would contain real
# customer rows) can never be committed by accident...
*.sql
# ...but sql/ holds schema migrations, not data. They must be version-controlled:
# this rule previously swallowed 001, 003, 004, 006 and 008 silently, leaving the
# directory unable to rebuild a Supabase project from scratch. Dumps still get
# ignored anywhere else in the tree.
!sql/*.sql

# Scripts and sensitive directories (for security reasons)
/cursor/

# Archive directory (for version checkpoints)
/archive/

# Logs and debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs
*.log

# Editor directories and files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
book-build/
.AI-Setup/

# Playwright test artifacts
tests/results/

# Python bytecode
scripts/__pycache__/
art-raw/

# factcheck network pass: cached HTTP responses, one file per URL. This is what
# makes the pass resumable across archive.org backoff, so it is local state and
# never a commit.
.factcheck-cache/
