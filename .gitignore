.DS_Store
node_modules
node_modules/
/build
/.svelte-kit
/package
.env
.env.*
!.env.example
.vercel
.output
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Add these lines to ignore pnpm store
.pnpm-store
**/node_modules/.pnpm/

cloudflare_logs/Discord.dmg

# Supabase files (for security reasons)
/supabase/
# Blanket-ignore .sql so a stray database dump (which would contain real
# customer rows) can never be committed by accident...
*.sql
# ...but sql/ holds schema migrations, not data. They must be version-controlled:
# this rule previously swallowed 001, 003, 004, 006 and 008 silently, leaving the
# directory unable to rebuild a Supabase project from scratch. Dumps still get
# ignored anywhere else in the tree.
!sql/*.sql

# Scripts and sensitive directories (for security reasons)
/cursor/

# Archive directory (for version checkpoints)
/archive/

# Logs and debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs
*.log

# Editor directories and files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
book-build/
.AI-Setup/

# Playwright test artifacts
tests/results/

# Python bytecode
scripts/__pycache__/
scripts/sts_lib/__pycache__/
art-raw/

# factcheck network pass: cached HTTP responses, one file per URL. This is what
# makes the pass resumable across archive.org backoff, so it is local state and
# never a commit.
.factcheck-cache/

# Playwright's HTML reporter and its results.json. Regenerated on every run, and
# results.json churns thousands of lines per run, which buries real diffs in
# review. tests/results/ above was already ignored; this is the same class of
# artifact and was tracked only by oversight.
tests/reports/

# Splash probe frames. scripts/probe_splash.mjs writes a PNG per timestamp plus
# the negative control; the script is the artifact worth keeping, not its output.
scripts/.probe-out/

# create-video render cache: hashed segment mp4s, extracted frames and text
# fragments. Keyed by content hash, rebuilt on demand, and large.
promo/**/.cvcache/

# empirica reflex checkpoints. Per-transaction session state written by the
# epistemic harness, not project source.
.empirica_reflex_logs/
