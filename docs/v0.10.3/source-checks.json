  "additions": [
    {
      "section": "31-how-to-use.md",
      "file": "v103-reading-routes.svg",
      "alt": "Three reading routes: Introduction, Chapter 19 and Appendix C; add Preface, Chapters 6 and 12, and Conclusion for a wider view; or read every section in order.",
      "image_block": "![Three reading routes: Introduction, Chapter 19 and Appendix C; add Preface, Chapters 6 and 12, and Conclusion for a wider view; or read every section in order.](/book-images/v103-reading-routes.svg)",
      "caption_block": "*Three ways in. The short route gives you the argument and plan; the full route follows Elijah through the chapters.*"
    },
    {
      "section": "00-chapter0.md",
      "file": "v103-narrative-bear-flag.png",
      "alt": "Illustration of three realtors raising glasses beside Elijah and his laptop at the Bear Flag.",
      "image_block": "![Illustration of three realtors raising glasses beside Elijah and his laptop at the Bear Flag.](/book-images/v103-narrative-bear-flag.png)",
      "caption_block": "*Fictional scene: the Bear Flag toast. Elijah hears what his demonstration helped set in motion.*"
    },
    {
      "section": "06-chapter4.md",
      "file": "v103-narrative-near-end.png",
      "alt": "Illustration of Elijah holding coffee at his apartment window at dawn, with a closed laptop behind him.",
      "image_block": "![Illustration of Elijah holding coffee at his apartment window at dawn, with a closed laptop behind him.](/book-images/v103-narrative-near-end.png)",
      "caption_block": "*Fictional scene: the near end. Elijah closes the spreadsheet and returns his attention to the world outside his window.*"
    },
    {
      "section": "09-chapter7.md",
      "file": "v103-narrative-passing-beans.png",
      "alt": "Illustration of Marta passing a bowl of beans to Denny at the cooperative's plywood dinner table.",
      "image_block": "![Illustration of Marta passing a bowl of beans to Denny at the cooperative's plywood dinner table.](/book-images/v103-narrative-passing-beans.png)",
      "caption_block": "*Fictional scene: pass the beans. The conversation turns from retraining to the floor people need beneath them.*"
    },
    {
      "section": "27-chapter19.md",
      "file": "v103-narrative-rosa-testimony.png",
      "alt": "Illustration of Rosa speaking at a county microphone in her warehouse shirt, with a brace on her right wrist.",
      "image_block": "![Illustration of Rosa speaking at a county microphone in her warehouse shirt, with a brace on her right wrist.](/book-images/v103-narrative-rosa-testimony.png)",
      "caption_block": "*Fictional scene: Rosa at the county hearing. A funded route means households can plan beyond the next delivery.*"
    },
    {
      "section": "24-appendix-c.md",
      "file": "v103-service-ledger.svg",
      "alt": "An open ledger with four continuing service costs: equipment, maintenance, remaining labor and delivery. No prices or budget estimates are shown.",
      "image_block": "![An open ledger with four continuing service costs: equipment, maintenance, remaining labor and delivery. No prices or budget estimates are shown.](/book-images/v103-service-ledger.svg)",
      "caption_block": "*Free to the person eating still leaves a working ledger: equipment, maintenance, remaining labor, and delivery need dependable funding.*"
    },
    {
      "section": "26-appendix-e.md",
      "file": "v103-offline-check.svg",
      "alt": "A phone and an offline retrieval test: save a reference you may copy, record source and date, turn the network off, then open the copy and find an answer.",
      "image_block": "![A phone and an offline retrieval test: save a reference you may copy, record source and date, turn the network off, then open the copy and find an answer.](/book-images/v103-offline-check.svg)",
      "caption_block": "*Tier 0 ends with a test: can you open the reference and find what you need with the network off? Record the source and date so you know which copy you have.*"
    },
    {
      "section": "29-appendix-g.md",
